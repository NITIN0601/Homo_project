# ==============================================================================
# Monorepo Root & Docker Compose Environment Configuration Template
# ==============================================================================
# This root file provides default environment values for Docker Compose
# (infra/docker-compose.yml) and serves as the monorepo root orchestration guide.
#
# ─── LOCAL DEVELOPMENT WORKFLOW ───────────────────────────────────────────────
# For running frontend and backend independently in local development:
#
# 1. Frontend (React + Vite):
#    cp frontend/.env.example frontend/.env
#
# 2. Backend (FastAPI + Python 3.14):
#    cp backend/.env.example backend/.env
#
# ─── DOCKER COMPOSE ORCHESTRATION WORKFLOW ────────────────────────────────────
# For running the full multi-container stack via Docker:
#    cp .env.example .env
#    docker compose -f infra/docker-compose.yml up --build
# ==============================================================================

# ─── Runtime Environment & Mock Toggle ───────────────────────────────────────
APP_ENV=development
USE_MOCK_DATA=false

# ─── Database & Auth Secrets (Self-Hosted Supabase / PostgreSQL) ──────────────
POSTGRES_DB=postgres
POSTGRES_PASSWORD=agastya_local_secure_pwd_2026
JWT_SECRET=agastya-local-jwt-secret-key-2026-secure-auth
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_service

# ─── Service Port Bindings ───────────────────────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8000
SUPABASE_PORT=54321
VOICESTUDIO_PORT=3900

# ─── Networking URLs ──────────────────────────────────────────────────────────
SUPABASE_REST_URL=http://127.0.0.1:54321/rest/v1
FRONTEND_URL=http://localhost:5173
