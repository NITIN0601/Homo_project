# ==============================================================================
# Healthcare Platform Local Environment Configuration (Template)
# ==============================================================================

# ─── Mock Data SSOT Toggle ───────────────────────────────────────────────────
# Set to "true" for offline demonstration with mock accounts, visits, and stock.
# Set to "false" to connect to the live local FastAPI backend & self-hosted Supabase EHR.
VITE_USE_MOCK_DATA=false

# ─── Local FastAPI Backend Engine (Admin PC Desktop) ──────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_PYTHON_BACKEND=true

# ─── Self-Hosted Local Supabase (Docker on Admin PC) ──────────────────────────
# Exposes PostgREST, GoTrue Auth & Storage on port 54321
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy

# ─── Local VoiceStudio Speech-to-Text Engine ─────────────────────────────────
# debpalash/VoiceStudio local Whisper server (optional, port 3900)
VITE_VOICESTUDIO_URL=http://127.0.0.1:3900

# ─── Clinic Communications & Logistics Placeholders ───────────────────────────
VITE_WHATSAPP_BUSINESS_NUMBER=+000000000000
VITE_WHATSAPP_ACCOUNT_ID=WABA-PLACEHOLDER
VITE_BLUEDART_LOGISTICS_KEY=mock_sandbox_logistics_token
VITE_APP_ENV=production
