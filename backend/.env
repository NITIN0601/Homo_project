# ==============================================================================
# Agastya Classical Homeopathy Backend Server Environment
# Runs locally on Admin PC Desktop (0.0.0.0:8000)
# ==============================================================================

# ─── Mock Data Toggle ─────────────────────────────────────────────────────────
# When "true", returns mock demonstration outputs if live AI/STT is unavailable.
# When "false", enforces strict clinical safety and prevents synthetic prescriptions.
USE_MOCK_DATA=false

# ─── Server Networking ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Self-Hosted Supabase / PostgreSQL Local Storage ──────────────────────────
# PostgREST REST endpoint exposed by local Docker Compose stack on Admin PC
SUPABASE_REST_URL=http://127.0.0.1:54321/rest/v1
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_service

# ─── Free AI Parsing: Google Gemini 2.5 Flash ─────────────────────────────────
# Server-side API key for structured clinical JSON parsing (response_mime_type=application/json)
GEMINI_API_KEY=

# ─── Optional Local Speech-to-Text & Alternative LLMs ────────────────────────
VOICESTUDIO_URL=http://127.0.0.1:3900/v1/audio/transcriptions
OLLAMA_ENDPOINT=http://127.0.0.1:11434
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Forensic Health-Data Watermarking (HMAC-SHA256) ─────────────────────────
CLINICAL_WATERMARK_SECRET=replace_with_a_secure_random_64_char_hex_secret_here

# ─── Google Calendar Service Account & Automated Invites ──────────────────────
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials.json
GOOGLE_CALENDAR_ID=primary

# ─── Resend Transactional Email API ──────────────────────────────────────────
RESEND_API_KEY=
CLINIC_ADMIN_EMAIL=vaishnavikshetty@gmail.com
RESEND_FROM_EMAIL="Agastya Clinic <onboarding@resend.dev>"
