# ==============================================================================
# Backend Server Environment Configuration (FastAPI + Python 3.14)
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp backend/.env.example backend/.env
#
# NOTE ON CLINICAL & TENANT DATA:
# Hospital/clinic branding, doctor profiles, consultation fees, and addresses
# are NOT stored here. They are dynamically managed in the database/datastore
# through the Super Admin and Admin management portals (e.g. /api/v1/hospitals,
# /api/v1/doctors). This file contains strictly infrastructure and security keys.
# ==============================================================================

# ─── Server Networking & Runtime Flags ────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
APP_ENV=development
USE_MOCK_DATA=false
FRONTEND_URL=http://localhost:5173

# ─── Multi-Tenant & Platform Scaling Quotas (Phase 1) ─────────────────────────
DEFAULT_HOSPITAL_ID=default
DEFAULT_DOCTOR_ID=doc-default
MAX_SUPER_ADMINS=5
MAX_ADMINS=10
MAX_CUSTOMERS_PER_HOSPITAL=1000

# ─── Security, Authentication & Session Tokens ────────────────────────────────
# In production, generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=ehr-platform-jwt-secret-key-2026-secure-auth
ACCESS_TOKEN_EXPIRE_DAYS=7
CLINICAL_WATERMARK_SECRET=replace_with_a_secure_random_64_char_hex_secret_here
# Initial bootstrap admin emails permitted to claim administrative access
AUTHORIZED_ADMIN_EMAILS=superadmin@example.com,admin@example.com

# ─── Database & Storage Engine (PostgreSQL / Supabase / PostgREST) ────────────
SUPABASE_REST_URL=http://127.0.0.1:54321/rest/v1
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_service

# ─── AI Repertorization & Clinical Reasoning (Optional) ───────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_ENDPOINT=http://127.0.0.1:11434
VOICESTUDIO_URL=http://127.0.0.1:3900/v1/audio/transcriptions

# ─── External Communications & Notifications (Optional) ───────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Healthcare System <onboarding@resend.dev>
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=100609346426085

# ─── Calendar & External Scheduling (Optional) ────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials.json
GOOGLE_CALENDAR_ID=en.indian#holiday@group.v.calendar.google.com

# ─── CORS & Rate Limiting ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_UPLOAD=20/minute
