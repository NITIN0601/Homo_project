# ==============================================================================
# Healthcare Platform Backend Server Environment (Template)
# ==============================================================================

# ─── Mock Data Toggle ─────────────────────────────────────────────────────────
# When "true", returns mock demonstration outputs if live AI/STT is unavailable.
# When "false", enforces strict clinical safety and prevents synthetic prescriptions.
USE_MOCK_DATA=false

# ─── Server Networking ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Self-Hosted Supabase / PostgreSQL Local Storage ──────────────────────────
SUPABASE_REST_URL=http://127.0.0.1:54321/rest/v1
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_service

# ─── AI Parsing: Google Gemini 2.5 Flash ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional Local Speech-to-Text & Alternative LLMs ────────────────────────
VOICESTUDIO_URL=http://127.0.0.1:3900/v1/audio/transcriptions
OLLAMA_ENDPOINT=http://127.0.0.1:11434
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Forensic Health-Data Watermarking (HMAC-SHA256) ─────────────────────────
CLINICAL_WATERMARK_SECRET=replace_with_a_secure_random_64_char_hex_secret_here

# ─── Google Calendar Service Account & Automated Invites ──────────────────────
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials.json
GOOGLE_CALENDAR_ID=primary

# ─── Transactional Email API (Resend / SMTP) ──────────────────────────────────
RESEND_API_KEY=re_YourFreeApiKeyHere
CLINIC_ADMIN_EMAIL=admin@example.com
RESEND_FROM_EMAIL="Clinic Notifications <notifications@example.com>"

# ─── Generic Clinic Identity & Practice Configuration Placeholders ────────────
CLINIC_NAME="Healthcare Practice Name"
CLINIC_DOMAIN="example.com"
CLINIC_LOCATION="City, Country"
CLINIC_ADDRESS="123 Healthcare Ave, Suite 100, City, Country"
CLINIC_PHONE="+00 00000 00000"
DOCTOR_NAME="Dr. Practitioner Name, MD"
DOCTOR_SHORT_NAME="Dr. Practitioner"
DOCTOR_EMAIL="doctor@example.com"
DEFAULT_COURIER_PARTNER="Logistics Partner 🚚"
AUTHORIZED_ADMIN_EMAILS="admin@example.com,doctor@example.com"
