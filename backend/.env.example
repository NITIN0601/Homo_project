# ==============================================================================
# Backend Server Environment Configuration (FastAPI + Python 3.14)
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp backend/.env.example backend/.env
# ==============================================================================

# ─── Server Networking & Runtime Flags ────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
APP_ENV=development
USE_MOCK_DATA=false
FRONTEND_URL=http://localhost:5173

# ─── Multi-Tenant & Platform Scaling Quotas (Phase 1) ─────────────────────────
DEFAULT_HOSPITAL_ID=agastya
DEFAULT_DOCTOR_ID=doc-001
MAX_SUPER_ADMINS=5
MAX_ADMINS=10
MAX_CUSTOMERS_PER_HOSPITAL=1000

# ─── Clinic Identity & Customization Defaults (Generic Template) ──────────────
CLINIC_NAME=Agastya Classical Homeopathy Clinic
CLINIC_DOMAIN=agastyahomoeo.com
CLINIC_LOCATION=Bengaluru, India
CLINIC_ADDRESS=No. 10/2, 2nd Temple Road, 16th Cross, Malleshwaram, Bengaluru – 560003
CLINIC_PHONE=+91 98450 12345
CLINIC_ADMIN_EMAIL=admin@agastyahomoeo.com
DOCTOR_NAME=Dr. Bramarambha K, MD (Homoeopathy)
DOCTOR_SHORT_NAME=Dr. Bramarambha K
DOCTOR_EMAIL=doctor@agastyahomoeo.com
DEFAULT_COURIER_PARTNER=BlueDart Express 🚚

# ─── Security, Authentication & Session Tokens ────────────────────────────────
# In production, generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=agastya-local-jwt-secret-key-2026-secure-auth
ACCESS_TOKEN_EXPIRE_DAYS=7
CLINICAL_WATERMARK_SECRET=replace_with_a_secure_random_64_char_hex_secret_here
AUTHORIZED_ADMIN_EMAILS=admin@agastyahomoeo.com,doctor@agastyahomoeo.com,drbramarambha@agastyahomoeo.com

# ─── Database & Storage Engine (PostgreSQL / Supabase / PostgREST) ────────────
SUPABASE_REST_URL=http://127.0.0.1:54321/rest/v1
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_service

# ─── AI Repertorization & Clinical Reasoning (Optional) ───────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
