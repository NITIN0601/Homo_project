{
  "name": "homo-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:user": "npm --prefix frontend run dev:user",
    "dev:admin": "npm --prefix frontend run dev:admin",
    "dev:both": "npm --prefix frontend run dev:both",
    "dev:backend": "cd backend && (test -d venv && ./venv/bin/uvicorn main:app --reload --port 8000 || uvicorn main:app --reload --port 8000)",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "./test/run_tests.sh",
    "test:backend": "./test/run_tests.sh",
    "test:frontend": "npm --prefix frontend run test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "libphonenumber-js": "^1.13.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
