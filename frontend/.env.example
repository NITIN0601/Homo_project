# ==============================================================================
# Frontend Client Environment Configuration (Vite + React)
# ==============================================================================
# Copy this file to .env in the frontend directory:
#   cp frontend/.env.example frontend/.env
# ==============================================================================

# ─── Runtime Environment & Mock Data SSOT Toggle ──────────────────────────────
# Runtime mode: "development" | "production" | "test"
VITE_APP_ENV=development

# Set to "true" for offline standalone mode (uses in-browser mock data stores)
# Set to "false" to connect to the live FastAPI backend & PostgreSQL database
VITE_USE_MOCK_DATA=false

# ─── Core API Backend Gateway ─────────────────────────────────────────────────
# FastAPI backend URL (proxied or direct)
VITE_BACKEND_URL=http://localhost:8000/api/v1
# Legacy alias fallback supported by frontend/src/config/env.ts
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── Database & Storage Engine (PostgreSQL / Supabase) ────────────────────────
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy

# ─── Local VoiceStudio Speech-to-Text Engine (Optional) ───────────────────────
VITE_VOICESTUDIO_URL=http://127.0.0.1:3900

# ─── Client-Side AI API Keys (Optional Browser-Direct Model Studio) ───────────
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_OLLAMA_ENDPOINT=http://127.0.0.1:11434

# ─── Telemetry & Observability (Optional) ─────────────────────────────────────
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ─── Logistics & Shipping Integration (Optional Sandbox) ──────────────────────
VITE_BLUEDART_LOGISTICS_KEY=mock_sandbox_logistics_token
